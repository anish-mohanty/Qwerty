<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd
       http://www.springframework.org/schema/context
       http://www.springframework.org/schema/context/spring-context-3.0.xsd">

    <!-- object of customer -->
    <bean id="customer" class="com.cognizant.banking.models.Customer">
        <property name="accountNo" value="6855858"></property>
        <property name="fullName" ref="fullName"></property>
        <property name="address" ref="address"></property>
        <property name="email" value="param@gmail.com"></property>
        <property name="contactNo" value="7838739396"></property>
    </bean>

    <!-- object of fullName -->
    <bean id="fullName" class="com.cognizant.banking.models.FullName">
        <property name="firstName" value="Parameswari"></property>
        <property name="lastName" value="Ettiappan"></property>
    </bean>

    <!-- object of Address -->
    <bean id="address" class="com.cognizant.banking.models.Address">
        <constructor-arg index="0" type="String" value="8A"></constructor-arg>
        <constructor-arg index="1" type="String" value="Gandhi Street"></constructor-arg>
        <constructor-arg index="2" type="String" value="Chennai"></constructor-arg>
        <constructor-arg index="3" type="long" value="600001"></constructor-arg>
    </bean>

</beans>
